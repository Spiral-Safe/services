# Production billing is deliberately fail-closed. Supply every placeholder from
# a secret manager; never commit real values or log the resolved environment.
BILLING_MODE=postgres
DATABASE_URL=postgresql://spiral_billing:REPLACE_ME@postgres.example:5432/spiral_safe
DATABASE_SSL=true
API_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CONSOLE_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_RANDOM_SECRET
CONSOLE_SESSION_TTL_MS=28800000
CONSOLE_ORIGIN=https://console.example.com
BILLING_RESERVATION_TTL_MS=300000

# Amounts are operator estimates in the currency's minor unit. Metronome's
# rate card and contract are the usage-rating authority. Every external ID must
# be distinct per plan; these are placeholders, not launch pricing.
BILLING_PLANS_JSON=[{"id":"operator_plan","name":"Operator configured plan","activeWalletLimit":100,"transactionLimit":10000,"walletUnitAmount":0,"transactionUnitAmount":0,"stripeProductId":"prod_REPLACE","stripePriceId":"price_REPLACE_BASE_SUBSCRIPTION","metronomeProductId":"REPLACE_METRONOME_PRODUCT_UUID","metronomeRateCardId":"REPLACE_METRONOME_RATE_CARD_UUID"}]

# Use a least-privilege Stripe restricted key. Checkout charges only the base
# subscription Price; usage invoices are produced by the verified Metronome to
# Stripe invoicing integration.
STRIPE_API_KEY=rk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_CHECKOUT_SUCCESS_URL=https://console.example.com/developer?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://console.example.com/developer?checkout=cancel
STRIPE_PORTAL_RETURN_URL=https://console.example.com/developer
STRIPE_CHECKOUT_INTENT_VERSION=v1

METRONOME_API_TOKEN=REPLACE
METRONOME_INGEST_URL=https://api.metronome.com/v1/ingest
METRONOME_EXPORT_INTERVAL_MS=10000
METRONOME_BATCH_SIZE=100
# Set true only after completing the environment-level Stripe connection,
# rate-card/product mapping, contract setup, and a sandbox invoice test.
METRONOME_STRIPE_INVOICING_VERIFIED=false
